# Installed packages (recreated by "npm install")
node_modules/

# Secrets and machine-specific settings. Only the placeholder file .env.example is committed.
.env
.env.*
!.env.example

# Runtime data: backups, old SQLite files and the old tasks.json (company data, kept out of Git)
backups/
*.sqlite
data/*.db
data/*.db-wal
data/*.db-shm
data/*.tmp
data/tasks.json

# Logs
*.log

# Separate demo data folder (see DEMO_GUIDE.md)
demo-data/
