{
  "name": "erp-rebuild-task-tracker",
  "version": "3.0.0",
  "private": true,
  "description": "Internal task tracker for the ERP rebuild team (Node.js, Express, MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
