{
  "name": "erp-rebuild-task-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Internal task tracker for the ERP rebuild team (Node.js, Express, SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "import-legacy": "node --env-file-if-exists=.env scripts/import-legacy.js",
    "map-module": "node --env-file-if-exists=.env scripts/map-module.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
