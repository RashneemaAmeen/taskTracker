# Example settings. To use them: copy this file, name the copy ".env", and edit the values.
# "npm start" loads .env automatically if it exists. Without a .env file the defaults below apply.
# Never commit your real .env file (it is listed in .gitignore).

# Port the Node.js app listens on.
PORT=3000

# Address to listen on.
#   127.0.0.1 = only this computer can connect (use this behind IIS, and on your laptop).
#   0.0.0.0   = other computers on the network can connect directly.
HOST=127.0.0.1

# Folder for the SQLite database (erp-tracker.db). Relative paths start from the project folder.
DATA_DIR=./data

# Optional: full path of the database file, if it should not live inside DATA_DIR.
# DB_FILE=D:\erp-tracker-data\erp-tracker.db

# Folder where "npm run backup" saves copies of the database.
BACKUP_DIR=./backups

# Optional, for use behind IIS: the public address(es) of the site, separated by commas.
# Only needed if saving fails with "Origin does not match this site" (see README, section 10).
# ALLOWED_ORIGINS=http://erp-tasks.company.local
