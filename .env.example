# Example settings. To use them: copy this file, name the copy ".env", and edit the values
# (PowerShell:  Copy-Item .env.example .env   then   notepad .env).
# The application, and every npm script, reads .env automatically if it exists.
# Never commit your real .env file (it is listed in .gitignore). This example holds
# placeholders only. Save .env as UTF-8. If a value contains #, spaces or quotes, wrap it
# in single quotes, for example DB_PASSWORD='my pass#word'.

# ---- The web application ----
# Port the Node.js app listens on.
PORT=3000

# Address to listen on.
#   127.0.0.1 = only this computer can connect (use this behind IIS, and on your laptop).
#   0.0.0.0   = other computers on the network can connect directly.
HOST=127.0.0.1

# ---- MySQL ----
# The account the application logs in with. It only needs SELECT, INSERT, UPDATE and DELETE
# on the database; it never creates or changes tables (an administrator applies
# scripts/schema.mysql.sql once).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_task_tracker
DB_USER=erp_tracker_app
# Type the real password here on the server. Leave it out of chat, email and Git.
DB_PASSWORD=

# Optional: maximum number of simultaneous MySQL connections (default 10).
# DB_CONNECTION_LIMIT=10

# ---- Backups and old data ----
# Folder where "npm run backup" saves .sql backups.
BACKUP_DIR=./backups

# Optional: full path of mysqldump.exe, if Windows cannot find it. Use single quotes.
# MYSQLDUMP_PATH='C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe'

# Folder holding old files that are only read by "npm run import-legacy" (tasks.json) and
# "npm run import-sqlite" (erp-tracker.db). Not used when the application is running.
DATA_DIR=./data
# Optional: full path of the old SQLite file to import.
# SQLITE_FILE=D:\old-data\erp-tracker.db

# ---- Behind IIS or another proxy (optional) ----
# The public address(es) of the site, separated by commas. Only needed if saving fails with
# "Origin does not match this site" (see README).
# ALLOWED_ORIGINS=http://erp-tasks.company.local
